# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Concreta uses bun as the sole package manager. Block other lockfiles
# from being committed so accidental `npm install` / `yarn install` /
# `pnpm install` runs do not contaminate the repo.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gstack/

# Design exploration prototypes (not part of the app)
design-preview*.html

# Pyodide self-hosted runtime (~16 MB) — generado por scripts/fetch-pyodide-assets.mjs
# en predev/prebuild. No se versiona; se regenera desde node_modules/pyodide + CDN.
public/pyodide/

# Fuentes variables de origen de Arimo (~1 MB), sólo entrada de
# scripts/subset-pdf-font.py. Lo que se versiona es su SALIDA subseteada
# (src/lib/pdf/fuenteArimo.ts); el .ttf se vuelve a descargar si hace falta,
# como los assets de Pyodide.
scripts/vendor/

# Bytecode de Python: lo genera py_compile / Pyodide sobre el PySlope vendorizado.
__pycache__/
*.pyc
